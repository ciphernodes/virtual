<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cipher_device_profiles.xml" />
        <exclude domain="sharedpref" path="cipher_virtual_prefs.xml" />
        <exclude domain="database" path="cipher_virtual.db" />
        <exclude domain="database" path="cipher_virtual.db-shm" />
        <exclude domain="database" path="cipher_virtual.db-wal" />
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="workspaces" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cipher_device_profiles.xml" />
        <exclude domain="file" path="workspaces" />
    </device-transfer>
</data-extraction-rules>
